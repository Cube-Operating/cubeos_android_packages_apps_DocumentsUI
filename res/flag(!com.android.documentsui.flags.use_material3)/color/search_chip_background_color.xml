<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CubeOS: iOS capsule — accent fill when selected, quiet system fill otherwise. -->
    <item android:state_selected="true" android:color="?android:attr/colorAccent"/>
    <item android:state_checked="true" android:color="?android:attr/colorAccent"/>
    <item android:state_enabled="true" android:color="@color/cube_chip_fill"/>
    <item android:state_enabled="false" android:color="@color/chip_background_disable_color"/>
</selector>